---
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import { business } from '../data/business';
import type { Lang } from '../i18n/ui';
interface Props { lang: Lang; kind: 'avis' | 'priv'; slug: string }
const { lang, kind, slug } = Astro.props;
const ca = lang === 'ca';
const heading = kind === 'avis' ? (ca ? 'Avís legal' : 'Aviso legal') : ca ? 'Privacitat' : 'Privacidad';
---
<Base lang={lang} title={`${heading} · SERIN`} description={`${heading} · ${business.fullName}`} slug={slug}>
  <Header lang={lang} slug={slug} />
  <main id="contingut" class="mx-auto max-w-3xl px-4 py-20 sm:px-8">
    <h1 class="rotul text-[clamp(2.5rem,6vw,4rem)]">{heading}</h1>
    <div class="mt-10 space-y-5 text-lg leading-relaxed">
      {kind === 'avis' ? (
        <>
          <p>{ca ? 'En compliment de la Llei 34/2002 (LSSI-CE), s’informa de les dades del titular d’aquest lloc web.' : 'En cumplimiento de la Ley 34/2002 (LSSI-CE), se informa de los datos del titular de este sitio web.'}</p>
          <p>{business.fullName}<br />NIF: <mark class="bg-paper-2 px-1">{ca ? 'pendent' : 'pendiente'}</mark><br />{business.street}, {business.postalCode} {business.city}<br />{business.email} · {business.phones[0].display}</p>
        </>
      ) : (
        <>
          <p>{ca ? 'El formulari no envia ni guarda dades en aquest lloc: prepara un missatge al teu WhatsApp. Només si decideixes enviar-lo, SERIN el rep per respondre la teva sol·licitud.' : 'El formulario no envía ni guarda datos en este sitio: prepara un mensaje en tu WhatsApp. Solo si decides enviarlo, SERIN lo recibe para responder a tu solicitud.'}</p>
          <p>{ca ? 'Aquest lloc no fa servir galetes d’analítica ni de publicitat.' : 'Este sitio no usa cookies de analítica ni de publicidad.'}</p>
          <p>{ca ? 'Responsable' : 'Responsable'}: {business.fullName}, {business.street}, {business.city} · {business.email}</p>
        </>
      )}
      <p class="text-sm text-tinta-2">{ca ? 'Document provisional: es completa amb el titular abans de publicar.' : 'Documento provisional: se completa con el titular antes de publicar.'}</p>
    </div>
  </main>
  <Footer lang={lang} />
</Base>
