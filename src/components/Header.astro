---
import Logo from './Logo.astro';
import { business, telUrl } from '../data/business';
import { ui, tr, path, type Lang } from '../i18n/ui';
interface Props { lang: Lang; slug?: string }
const { lang, slug = '' } = Astro.props;
const links = [
  { href: '#pressupost', label: tr(lang, ui.nav.configurador) },
  { href: '#diari', label: tr(lang, ui.nav.diari) },
  { href: '#treballs', label: tr(lang, ui.nav.galeria) },
  { href: '#serveis', label: tr(lang, ui.nav.serveis) },
  { href: '#contacte', label: tr(lang, ui.nav.contacte) },
];
const home = path(lang);
---
<header class="sticky top-0 z-40 border-b border-ratlla bg-paper/90 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-[90rem] items-center justify-between gap-4 px-4 sm:px-8">
    <a href={home} class="flex items-center gap-3 text-logo">
      <Logo class="h-6 sm:h-7" />
      <span class="hidden text-sm text-tinta-2 sm:inline">{lang === 'ca' ? 'serveis i instal·lacions' : 'servicios e instalaciones'}</span>
      <span class="sr-only">{lang === 'ca' ? '(inici)' : '(inicio)'}</span>
    </a>
    <nav aria-label={lang === 'ca' ? 'Principal' : 'Principal'} class="hidden xl:block">
      <ul class="flex items-center gap-6 font-medium text-tinta-2">
        {links.map((l) => <li><a href={l.href} class="py-2 hover:text-esmalt">{l.label}</a></li>)}
      </ul>
    </nav>
    <div class="flex items-center gap-3">
      <nav aria-label={lang === 'ca' ? 'Idioma' : 'Idioma'} class="flex overflow-hidden rounded-full border border-ratlla text-sm font-semibold">
        <a href={path('ca', slug)} hreflang="ca" lang="ca" aria-current={lang === 'ca' ? 'true' : undefined} class="px-3 py-1.5 aria-[current]:bg-tinta aria-[current]:text-white">CA</a>
        <a href={path('es', slug)} hreflang="es" lang="es" aria-current={lang === 'es' ? 'true' : undefined} class="px-3 py-1.5 aria-[current]:bg-tinta aria-[current]:text-white">ES</a>
      </nav>
      <a href={telUrl(business.phones[0].e164)} class="hidden font-semibold tabular-nums text-tinta md:inline">{business.phones[0].display}</a>
      <a href="#pressupost" class="btn btn-esmalt hidden min-h-10 py-2 sm:inline-flex">{tr(lang, ui.nav.cta)}</a>
    </div>
  </div>
</header>
