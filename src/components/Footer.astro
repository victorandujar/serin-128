---
import Logo from './Logo.astro';
import { business } from '../data/business';
import { isDemo } from '../lib/site';
import { ui, tr, path, type Lang } from '../i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
---
<footer class="border-t-8 border-esmalt bg-tinta pb-24 text-paper md:pb-0">
  <div class="mx-auto flex max-w-[90rem] flex-wrap items-end justify-between gap-8 px-4 py-14 sm:px-8">
    <div>
      <Logo class="h-10 text-white" />
      <p class="mt-3 text-white/70">{lang === 'ca' ? 'serveis i instal·lacions' : 'servicios e instalaciones'} · {business.city}</p>
    </div>
    <nav aria-label={tr(lang, ui.footer.legal)} class="flex gap-6 text-white/80">
      <a href={path(lang, lang === 'ca' ? 'avis-legal' : 'aviso-legal')} class="hover:underline">{tr(lang, ui.footer.legal)}</a>
      <a href={path(lang, lang === 'ca' ? 'privacitat' : 'privacidad')} class="hover:underline">{tr(lang, ui.footer.privacy)}</a>
    </nav>
  </div>
  <p class="eyebrow mx-auto flex max-w-[90rem] flex-wrap justify-between gap-4 border-t border-white/10 px-4 py-6 text-[0.68rem] text-white/50 sm:px-8"><span>© {new Date().getFullYear()} {business.fullName}</span>{isDemo && <span>{tr(lang, ui.footer.demo)}</span>}</p>
</footer>
