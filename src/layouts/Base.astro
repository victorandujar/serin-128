---
import '../styles/global.css';
import Seo from '../components/Seo.astro';
import Schema from '../components/Schema.astro';
import { isDemo } from '../lib/site';
import { ui, tr, type Lang } from '../i18n/ui';
import rotul from '@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url';

interface Props { lang: Lang; title: string; description: string; slug?: string; schema?: boolean }
const { lang, title, description, slug = '', schema = false } = Astro.props;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <script is:inline>document.documentElement.classList.add('js')</script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#1d3b8f" />
    <link rel="preload" href={rotul} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <Seo title={title} description={description} lang={lang} slug={slug} />
    {schema && <Schema />}
  </head>
  <body class="min-h-dvh">
    <a href="#contingut" class="sr-only focus:not-sr-only focus:fixed focus:left-3 focus:top-3 focus:z-[100] focus:bg-tinta focus:px-4 focus:py-2 focus:text-white">{lang === 'ca' ? 'Saltar al contingut' : 'Saltar al contenido'}</a>
    {isDemo && (
      <aside aria-label={tr(lang, ui.demo.text)} class="relative z-50 bg-tinta text-paper">
        <p class="eyebrow mx-auto flex max-w-[90rem] flex-wrap items-center justify-center gap-x-3 px-4 py-2 text-center text-[0.68rem]"><span>{tr(lang, ui.demo.text)}</span><span aria-hidden="true">·</span><span class="hidden sm:inline">{tr(lang, ui.demo.by)}</span><span class="sm:hidden">Web Local Growth</span></p>
      </aside>
    )}
    <slot />
    <script>
      import '../scripts/reveal';
    </script>
  </body>
</html>
